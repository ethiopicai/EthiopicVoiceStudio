* text=auto
*.rs text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.svelte text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
