"""Torch-free reference inference for the Amharic CTC ASR ONNX variants (asr-wav2vec_ctc-300m-amh-int8_onnx, asr-wav2vec_ctc-1b-amh-int8_onnx).
Needs only numpy + onnxruntime. Reading files: soundfile if installed, else the stdlib `wave` module (PCM WAV);
resampling: scipy.signal.resample_poly if installed, else a numpy windowed-sinc resampler.

    from asr_onnx_infer import OnnxCTCTranscriber
    asr = OnnxCTCTranscriber("studio_models/asr-wav2vec_ctc-300m-amh-int8_onnx", threads=4)
    r = asr.transcribe("clip.wav")       # path, or a float array (pass sr= if it is not 16 kHz mono)
    r["text"]; r["words"]                # [{"word": "ሰላም", "start": 0.42, "end": 0.86}, ...] seconds
    r["model_version"]                   # from variant.json: store it with the output

    python asr_onnx_infer.py <variant folder> <audio>... [--threads 4] [--words]

Uses the same CTC transcription behavior as the included PyTorch CTCTranscriber:
- audio 16 kHz mono float32; audio over 30 s is cut at the quietest 20 ms frame of the last 20-30 s window, and each
  piece is normalised on its own: zero mean, unit variance over the piece, (x - mean) / sqrt(var + 1e-5) (this is
  torch.nn.functional.layer_norm over the whole clip);
- greedy CTC: argmax per 20 ms frame, collapse repeats, drop blank/special ids (< 4); words split at the space token
  (id 4); text = the words joined by single spaces;
- word times: a word starts at its first character's frame and ends after its last one (edges +-1-2 frames).
For live dictation, StreamingTranscriber in transcribe.py only needs an object with .decode(wav, offset) -> words,
which this class provides, so the same streaming logic can be ported or reused unchanged.
"""
import json
import os
import sys

import numpy as np

SAMPLE_RATE = 16000
FRAME = 320  # samples per output frame (20 ms)
N_SPECIAL, SPACE_ID = 4, 4


# ---------------------------------------------------------------- audio
def read_audio(path):
    """-> (float32 mono array, sample rate)."""
    try:
        import soundfile as sf
        x, sr = sf.read(path, dtype="float32", always_2d=True)
        return x.mean(1), sr
    except ImportError:
        import wave
        with wave.open(path, "rb") as w:
            sr, ch, width, n = w.getframerate(), w.getnchannels(), w.getsampwidth(), w.getnframes()
            raw = w.readframes(n)
        if width == 3:  # 24-bit PCM -> int32
            b = np.frombuffer(raw, np.uint8).reshape(-1, 3)
            x = (b[:, 0].astype(np.int32) | (b[:, 1].astype(np.int32) << 8) | (b[:, 2].astype(np.int32) << 16))
            x = np.where(x >= 1 << 23, x - (1 << 24), x) / float(1 << 23)
        else:
            dt = {1: np.uint8, 2: np.int16, 4: np.int32}[width]
            x = np.frombuffer(raw, dt).astype(np.float64)
            x = (x - 128) / 128 if width == 1 else x / float(np.iinfo(dt).max + 1)
        return x.reshape(-1, ch).mean(1).astype(np.float32), sr


def resample(x, sr, target=SAMPLE_RATE):
    """Band-limited resampling to target Hz."""
    if sr == target:
        return np.asarray(x, np.float32)
    from math import gcd
    g = gcd(int(sr), target)
    up, down = target // g, int(sr) // g
    try:
        from scipy.signal import resample_poly
        return resample_poly(x, up, down).astype(np.float32)
    except ImportError:
        pass
    # numpy fallback: windowed-sinc interpolation (Kaiser, 16 zero crossings), computed in blocks
    ratio = target / sr
    cutoff = min(1.0, ratio) * 0.95  # of the input Nyquist
    half = 16 / cutoff
    n_out = int(np.ceil(len(x) * ratio))
    out = np.empty(n_out, np.float32)
    xp = np.concatenate([np.zeros(int(half) + 1), np.asarray(x, np.float64), np.zeros(int(half) + 2)])
    off = int(half) + 1
    taps = np.arange(-int(half), int(half) + 2)
    for s in range(0, n_out, 4096):
        t = np.arange(s, min(s + 4096, n_out)) / ratio  # input positions
        base = np.floor(t).astype(np.int64)
        idx = base[:, None] + taps[None, :]
        d = t[:, None] - idx
        r = np.clip(1 - (d / half) ** 2, 0, None)
        h = cutoff * np.sinc(cutoff * d) * np.i0(8.6 * np.sqrt(r)) / np.i0(8.6) * (np.abs(d) <= half)
        out[s:s + len(t)] = (xp[idx + off] * h).sum(1)
    return out


def load_audio(audio, sr=None):
    if isinstance(audio, (str, os.PathLike)):
        audio, sr = read_audio(str(audio))
    x = np.asarray(audio, np.float32)
    if x.ndim == 2:  # (samples, channels)
        x = x.mean(1)
    return resample(x, sr or SAMPLE_RATE)


def normalize(wav):
    """Per-clip zero mean / unit variance, as torch.nn.functional.layer_norm(wav, wav.shape) (eps 1e-5)."""
    w = wav.astype(np.float64)
    return ((w - w.mean()) / np.sqrt(w.var() + 1e-5)).astype(np.float32)


# ---------------------------------------------------------------- model
class OnnxCTCTranscriber:
    def __init__(self, variant_dir, threads=4, max_chunk_sec=30.0, min_chunk_sec=20.0, providers=None, mem_arena=False):
        """mem_arena False (default): peak RAM for a 30 s piece 1.3 GB instead of 2.0 GB (300M; 1B 2.5 vs 3.2 GB), ~4% slower."""
        import onnxruntime as ort
        so = ort.SessionOptions()
        so.intra_op_num_threads, so.inter_op_num_threads = threads, 1
        so.enable_cpu_mem_arena = mem_arena
        onnx = next(f for f in ("asr.int8.onnx", "asr.onnx") if os.path.exists(os.path.join(variant_dir, f)))
        self.session = ort.InferenceSession(os.path.join(variant_dir, onnx), so,
                                            providers=providers or ["CPUExecutionProvider"])
        self.vocab = json.load(open(os.path.join(variant_dir, "vocab.json"), encoding="utf-8"))
        vj = os.path.join(variant_dir, "variant.json")
        self.version = json.load(open(vj, encoding="utf-8")).get("model_version") if os.path.exists(vj) else None
        self.max_chunk, self.min_chunk = int(max_chunk_sec * SAMPLE_RATE), int(min_chunk_sec * SAMPLE_RATE)

    def logits(self, wav):
        """Raw 16 kHz piece (<= 40 s) -> (frames, vocab) float32 logits."""
        return self.session.run(None, {"input_values": normalize(wav)[None]})[0][0]

    def chunks(self, wav):
        """[(start, end)] samples, each at most max_chunk_sec, cut at the quietest 20 ms frame of the last window."""
        out, start = [], 0
        while len(wav) - start > self.max_chunk:
            lo, hi = start + self.min_chunk, start + self.max_chunk
            energy = np.square(wav[lo:hi][:(hi - lo) // FRAME * FRAME]).reshape(-1, FRAME).mean(1)
            cut = lo + int(energy.argmin()) * FRAME + FRAME // 2
            out.append((start, cut))
            start = cut
        return out + [(start, len(wav))]

    def transcribe(self, audio, sr=None):
        """audio: file path or float array (sr defaults to 16 kHz) -> {"text", "words", "duration", "model_version"}."""
        wav = load_audio(audio, sr)
        words = [w for a, b in self.chunks(wav) for w in self.decode(wav[a:b], a / SAMPLE_RATE)]
        return {"text": " ".join(w["word"] for w in words), "words": words,
                "duration": round(len(wav) / SAMPLE_RATE, 3), "model_version": self.version}

    def decode(self, wav, offset=0.0):
        """One piece of at most 40 s, normalised on its own -> words with times (+ offset seconds)."""
        if len(wav) < 400:  # under 25 ms: the conv front end can't take it
            return []
        return self.words(self.logits(np.ascontiguousarray(wav, np.float32)).argmax(-1).tolist(), offset)

    def words(self, path, offset=0.0):
        """Greedy CTC path (one id per frame) -> words; a token is emitted where the path changes to a non-blank id."""
        words, cur, prev = [], None, None
        for t, i in enumerate(path):
            if i != prev and i >= N_SPECIAL:
                if i == SPACE_ID:
                    cur = None
                else:
                    if cur is None:
                        cur = {"ids": [], "start": t}
                        words.append(cur)
                    cur["ids"].append(i)
            if i >= N_SPECIAL and i != SPACE_ID and cur is not None:
                cur["end"] = t + 1
            prev = i
        return [{"word": "".join(self.vocab[j] for j in w["ids"]), "start": round(offset + w["start"] * FRAME / SAMPLE_RATE, 2),
                 "end": round(offset + w["end"] * FRAME / SAMPLE_RATE, 2)} for w in words]

    def greedy_text(self, logits):
        """Plain greedy text of one piece's logits (spaces kept as emitted), like omniasr_hf.audio_text.ctc_greedy_decode."""
        ids = logits.argmax(-1)
        keep = np.concatenate([[True], ids[1:] != ids[:-1]])
        return "".join(self.vocab[i] for i in ids[keep] if i >= N_SPECIAL)


def main():
    import argparse
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("variant_dir")
    ap.add_argument("audio", nargs="+")
    ap.add_argument("--threads", type=int, default=4)
    ap.add_argument("--words", action="store_true", help="print JSON with word timings")
    a = ap.parse_args()
    asr = OnnxCTCTranscriber(a.variant_dir, threads=a.threads)
    for p in a.audio:
        r = asr.transcribe(p)
        print(json.dumps(dict(audio=p, **r), ensure_ascii=False) if a.words else f"{p}\t{r['text']}", flush=True)


if __name__ == "__main__":
    sys.exit(main())
