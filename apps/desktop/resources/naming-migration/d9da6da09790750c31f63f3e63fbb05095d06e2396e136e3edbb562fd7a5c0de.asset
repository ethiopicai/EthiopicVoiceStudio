"""Amharic text normalisation shared by speech alignment and character-error scoring.

fold(s)          merge letter variants that sound the same (ሐ/ኀ/ሃ -> ሀ, ሠ -> ሰ, ዐ/ኣ -> አ, ፀ -> ጸ, ...)
strip_punct(s)   remove punctuation (Ethiopic + ASCII + quotes/dashes), collapse whitespace
spoken_chars(s)  letters and digits only, folded (used for forced alignment and CER)
cer(ref, hyp)    character error rate on spoken_chars
"""
import re

FOLD_MAP = {'ሃ': 'ሀ', 'ሐ': 'ሀ', 'ሑ': 'ሁ', 'ሒ': 'ሂ', 'ሓ': 'ሀ', 'ሔ': 'ሄ', 'ሕ': 'ህ', 'ሖ': 'ሆ', 'ሗ': 'ኋ', 'ሠ': 'ሰ', 'ሡ': 'ሱ', 'ሢ': 'ሲ', 'ሣ': 'ሳ', 'ሤ': 'ሴ', 'ሥ': 'ስ', 'ሦ': 'ሶ', 'ሧ': 'ሷ', 'ቍ': 'ቁ', 'ኀ': 'ሀ', 'ኁ': 'ሁ', 'ኂ': 'ሂ', 'ኃ': 'ሀ', 'ኄ': 'ሄ', 'ኅ': 'ህ', 'ኆ': 'ሆ', 'ኍ': 'ሁ', 'ኣ': 'አ', 'ኵ': 'ኩ', 'ዉ': 'ው', 'ዐ': 'አ', 'ዑ': 'ኡ', 'ዒ': 'ኢ', 'ዓ': 'አ', 'ዔ': 'ኤ', 'ዕ': 'እ', 'ዖ': 'ኦ', 'ጕ': 'ጉ', 'ፀ': 'ጸ', 'ፁ': 'ጹ', 'ፂ': 'ጺ', 'ፃ': 'ጻ', 'ፄ': 'ጼ', 'ፅ': 'ጽ', 'ፆ': 'ጾ', 'ፇ': 'ጿ'}
_FOLD = str.maketrans(FOLD_MAP)
PUNCT = '!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~«»፠፡።፣፤፥፦፧፨–—‘’“”„…'
_PUNCT_RE = re.compile("[" + re.escape(PUNCT) + "]")


def fold(s):
    return s.translate(_FOLD)


def strip_punct(s):
    return " ".join(_PUNCT_RE.sub(" ", s).split())


def spoken_chars(s):
    return "".join(c for c in fold(s) if c.isalnum())


def norm_word(w):
    return spoken_chars(strip_punct(fold(w)))


def lev(a, b):
    if len(a) < len(b):
        a, b = b, a
    prev = list(range(len(b) + 1))
    for i, x in enumerate(a, 1):
        cur = [i]
        for j, y in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (x != y)))
        prev = cur
    return prev[-1]


def cer(ref, hyp):
    r, h = spoken_chars(ref), spoken_chars(hyp)
    return lev(r, h) / max(1, len(r))
