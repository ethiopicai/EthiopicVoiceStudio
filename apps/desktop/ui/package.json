{
  "name": "ethiopic-voice-studio-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:home-browser": "node --test tests/home-isolation.browser.mjs",
    "test:transcription-browser": "node --test tests/transcription-deletion.browser.mjs",
    "test:dictation-browser": "node --test tests/dictation.browser.mjs",
    "test:timed-transcript-browser": "node --test tests/timed-transcript.browser.mjs",
    "test:asr-runtime-browser": "node --test tests/asr-runtime.browser.mjs",
    "test:recording-batch-browser": "node --test tests/recording-batch.browser.mjs",
    "test:resource-setup-browser": "node --test tests/resource-setup.browser.mjs",
    "test:browser": "node --test tests/*.browser.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "svelte-check": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
