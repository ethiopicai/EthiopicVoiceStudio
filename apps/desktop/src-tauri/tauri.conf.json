{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EthiopicAI Voice Studio",
  "version": "0.1.0-rc.2",
  "identifier": "ai.ethiopic.voicestudio.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EthiopicAI Voice Studio",
        "width": 1100,
        "height": 780,
        "minWidth": 620,
        "minHeight": 580,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob:; object-src 'none'; frame-src 'self' about:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "1",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  }
}
